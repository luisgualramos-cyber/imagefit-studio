# URL pública (para canonical, sitemap y Open Graph). Cámbiala por tu dominio de Vercel.
VITE_SITE_URL=https://imagefitstudio.com

# Google AdSense (opcional). Sin estos valores se muestran huecos "ANUNCIO".
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_BELOW_TOOL=
VITE_ADSENSE_SLOT_BETWEEN=
VITE_ADSENSE_SLOT_AFTER_TOOLS=
VITE_ADSENSE_SLOT_BOTTOM=
VITE_ADSENSE_SLOT_SIDEBAR=

# Ampliación con IA generativa (servidor, OPCIONAL y DE PAGO). Desactivada si no se define.
OUTPAINT_ENABLED=false
STABILITY_API_KEY=
OUTPAINT_ALLOWED_ORIGIN=

# Datos del titular para el aviso legal (obligatorio). Ponlos en .env.production.local, que NO se sube a GitHub.
VITE_OWNER_NAME=
VITE_OWNER_NIF=
VITE_OWNER_ADDRESS=
