{
  "name": "imagefit-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-mediapipe.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-mediapipe.mjs",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/source-zip.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy:cf": "npm run build && wrangler pages deploy"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "@jsquash/avif": "^2.1.1",
    "@mediapipe/tasks-vision": "^1.2.3",
    "heic-to": "^1.6.7",
    "jszip": "^3.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "smartcrop": "^2.0.5",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/upng-js": "^2.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.162.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "AGPL-3.0-or-later"
}
